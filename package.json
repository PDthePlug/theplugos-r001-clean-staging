{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": "22.22.2",
    "npm": "11.9.0"
  },
  "volta": {
    "node": "22.22.2",
    "npm": "11.9.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:server": "node --env-file-if-exists=.env --import tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:assemble:debug": "npm run android:sync && ./android/gradlew -p android :app:assembleDebug",
    "android:assemble:release": "npm run android:sync && ./android/gradlew -p android :app:assembleRelease",
    "start": "node --env-file-if-exists=.env scripts/start-production.mjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:r001-inspector": "node scripts/test-r001-schema-dump-inspector.mjs",
    "test": "vitest run",
    "test:r002": "node scripts/test-r002-migration.mjs",
    "test:hub-protocol": "node --experimental-strip-types scripts/test-hub-crypto-protocol.mjs",
    "test:r003-local-hub": "node scripts/test-r003-local-hub-contract.mjs",
    "test:r004-order-authority": "node scripts/test-r004-order-transition-authority.mjs",
    "test:r005-cash-capture": "node scripts/test-r005-cash-shift-capture-contract.mjs",
    "test:r006-native-kitchen": "node scripts/test-r006-native-kitchen-workflow-contract.mjs",
    "test:r007-native-session": "node scripts/test-r007-native-station-entry-contract.mjs",
    "test:r008-cash-collection": "node scripts/test-r008-cash-collection-workflow-contract.mjs",
    "test:r009-shift-close": "node scripts/test-r009-cash-shift-close-contract.mjs",
    "test:browser-authority": "node scripts/test-browser-authority-boundary.mjs",
    "test:android-host": "node scripts/test-android-host-contract.mjs",
    "test:release-truth": "node scripts/test-release-truth.mjs",
    "test:all": "npm run test:r001-inspector && npm run test:r002 && npm run test:hub-protocol && npm run test:r003-local-hub && npm run test:r004-order-authority && npm run test:r005-cash-capture && npm run test:r006-native-kitchen && npm run test:r007-native-session && npm run test:r008-cash-collection && npm run test:r009-shift-close && npm run test:browser-authority && npm run test:android-host && npm run test:release-truth && npm test"
  },
  "dependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/core": "8.5.0",
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.112.2",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "commander": "^15.0.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "json-logic-js": "^2.0.5",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.22.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "ulid": "^3.0.2",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0",
    "@electric-sql/pglite": "^0.5.4",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^4.17.21",
    "@types/json-logic-js": "^2.0.8",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.10"
  }
}
